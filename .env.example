# Copy to .env and adjust. docker compose reads it automatically.
# Every setting bioseasy understands is listed in docs/configuration.md; this file holds the ones
# most installations actually change.

# --- Where things live -------------------------------------------------------------------------
# Where backups go on the host, e.g. a NAS share mounted at /mnt/nas/iphone-backups
BACKUP_ROOT=./backups
# App state and pair records. Keep this on local disk, not on the backup share: a pair record
# grants access to the device it belongs to.
DATA_DIR=./data
# Owner of both directories on the host (id -u / id -g)
PUID=1000
PGID=1000

# --- Image and port ----------------------------------------------------------------------------
# The published image. Pin a version (e.g. :1.0.0) instead of :latest if you would rather decide
# when to upgrade.
BIOSEASY_IMAGE=ghcr.io/werk-xyz/bioseasy:latest
BIOSEASY_PORT=8080

# --- Web ---------------------------------------------------------------------------------------
# The URL people open bioseasy at. Required for single sign-on, and used wherever bioseasy has to
# name itself - for example in the pairing command it hands out.
#BIOSEASY_BASE_URL=https://backup.example.net
# Session cookies carry the Secure flag by default, which assumes the HTTPS reverse proxy the
# install guide describes. Set this to false only if you deliberately serve bioseasy over plain
# HTTP: otherwise the browser discards the session cookie and signing in appears to do nothing.
BIOSEASY_SECURE_COOKIES=true

# --- HTTPS without a reverse proxy -------------------------------------------------------------
# Off by default: the documented setup puts a proxy in front and that proxy owns TLS. With no
# proxy, uncomment both lines and name every address the server is opened at - a certificate that
# carries none of the names in use matches nothing. Browsers warn until the certificate is trusted
# on the machine opening the page. Backups are unaffected either way.
#BIOSEASY_TLS=self-signed
#BIOSEASY_TLS_NAMES=backup.lan,192.168.1.10
# Or serve a certificate you already have:
#BIOSEASY_TLS=on
#BIOSEASY_TLS_CERT=/data/tls/your.crt
#BIOSEASY_TLS_KEY=/data/tls/your.key

# --- Single sign-on (optional) -----------------------------------------------------------------
# Sign in with a provider you already run. Accounts are matched by verified email address.
# Register <BIOSEASY_BASE_URL>/login/oidc/callback as the redirect URI. Full reference and the
# provider-specific traps: docs/configuration.md.
#BIOSEASY_OIDC_ISSUER=https://id.example.net/application/o/bioseasy/
#BIOSEASY_OIDC_CLIENT_ID=
#BIOSEASY_OIDC_CLIENT_SECRET=
#BIOSEASY_OIDC_NAME=Company sign-in
#BIOSEASY_OIDC_ALLOW_REGISTRATION=false
#BIOSEASY_OIDC_REQUIRED_GROUP=bioseasy-users

# --- Pairing helper downloads (optional) -------------------------------------------------------
# Where your users can download the helper app. bioseasy hosts nothing itself; point these at the
# release assets you want to offer.
#BIOSEASY_HELPER_URL_MACOS=
#BIOSEASY_HELPER_URL_LINUX=
#BIOSEASY_HELPER_URL_WINDOWS=

# Backup windows, retention, notification targets and the free-space threshold are not set here.
# An admin configures them in the web UI, so they change without a restart.
